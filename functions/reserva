export async function onRequest(context) {
  if (context.request.method !== 'POST') {
    return new Response('Method not allowed', { status: 405 });
  }

  try {
    const reservaData = await context.request.json();

    // Guardar en KV (Cloudflare KV Store)
    const reservaId = `reserva-${Date.now()}`;
    await context.env.KV.put(
      reservaId,
      JSON.stringify({
        ...reservaData,
        timestamp: new Date().toISOString()
      }),
      { expirationTtl: 86400 * 30 } // 30 días
    );

    // Enviar email (opcional - requiere configurar un servicio de email)
    // Por ahora solo guardamos en KV

    return new Response(
      JSON.stringify({ success: true, reservaId }),
      { status: 200, headers: { 'Content-Type': 'application/json' } }
    );

  } catch (error) {
    console.error('Error:', error);
    return new Response(
      JSON.stringify({ error: error.message }),
      { status: 500, headers: { 'Content-Type': 'application/json' } }
    );
  }
}
